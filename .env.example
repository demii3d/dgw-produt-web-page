# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
VITE_SITE_URL=https://www.example.com
# Optional: contact details (leave empty to keep the visible placeholders)
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
# Optional: form endpoint (e.g. Formspree). If empty, the contact form shows "not connected".
VITE_CONTACT_ENDPOINT=
# Optional: set when real store listings exist
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=
